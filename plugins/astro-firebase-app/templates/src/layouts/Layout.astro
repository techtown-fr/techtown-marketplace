---
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  requireAuth?: boolean;
}

const {
  title = "Application — TechTown",
  description = "Application interne TechTown",
  requireAuth = true,
} = Astro.props;

const siteName = "TechTown";
const siteUrl = Astro.url.href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- Désactiver l'indexation des apps internes -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    <Font
      cssVariable="--font-poppins"
      preload={[
        { weight: 400, style: "normal", subset: "latin" },
        { weight: 600, style: "normal", subset: "latin" },
      ]}
    />
  </head>
  <body data-require-auth={requireAuth ? "true" : "false"}>
    <slot />

    <script>
      import { onAuthStateChanged } from "firebase/auth";
      import { auth } from "../lib/firebase";

      const requireAuth = document.body.dataset.requireAuth === "true";

      if (requireAuth) {
        onAuthStateChanged(auth, (user) => {
          if (user && user.email?.endsWith("@techtown.fr")) {
            document.body.classList.add("auth-ready");
          } else {
            window.location.href = "/login";
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-black: #000000;
    --color-white: #ffffff;
    --color-blue: #1c62ed;
    --color-primary: #1c62ed;
    --color-text-white: #ffffff;

    --color-bg-light: #ffffff;
    --color-bg-dark: #0f0f0f;
    --color-bg-secondary-light: #f5f5f5;
    --color-bg-secondary-dark: #1a1a1a;
    --color-text-light: #000000;
    --color-text-dark: #f5f5f5;
    --color-text-muted-light: #666666;
    --color-text-muted-dark: #a0a0a0;
    --color-border-light: #e0e0e0;
    --color-border-dark: #2a2a2a;
    --color-card-bg-light: #ffffff;
    --color-card-bg-dark: #1a1a1a;
    --color-hover-bg-light: #f5f5f5;
    --color-hover-bg-dark: #252525;

    --color-bg: var(--color-bg-light);
    --color-bg-secondary: var(--color-bg-secondary-light);
    --color-text: var(--color-text-light);
    --color-text-muted: var(--color-text-muted-light);
    --color-border: var(--color-border-light);
    --color-card-bg: var(--color-card-bg-light);
    --color-hover-bg: var(--color-hover-bg-light);

    @media (prefers-color-scheme: dark) {
      --color-bg: var(--color-bg-dark);
      --color-bg-secondary: var(--color-bg-secondary-dark);
      --color-text: var(--color-text-dark);
      --color-text-muted: var(--color-text-muted-dark);
      --color-border: var(--color-border-dark);
      --color-card-bg: var(--color-card-bg-dark);
      --color-hover-bg: var(--color-hover-bg-dark);
    }

    @supports (color: light-dark(white, black)) {
      --color-bg: light-dark(var(--color-bg-light), var(--color-bg-dark));
      --color-bg-secondary: light-dark(
        var(--color-bg-secondary-light),
        var(--color-bg-secondary-dark)
      );
      --color-text: light-dark(var(--color-text-light), var(--color-text-dark));
      --color-text-muted: light-dark(
        var(--color-text-muted-light),
        var(--color-text-muted-dark)
      );
      --color-border: light-dark(var(--color-border-light), var(--color-border-dark));
      --color-card-bg: light-dark(var(--color-card-bg-light), var(--color-card-bg-dark));
      --color-hover-bg: light-dark(var(--color-hover-bg-light), var(--color-hover-bg-dark));
    }

    color-scheme: light dark;
    accent-color: var(--color-primary);

    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 1.5rem;
    --spacing-lg: 2rem;
    --spacing-xl: 3rem;

    --border-radius: 8px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: var(--font-poppins), sans-serif;
    font-size-adjust: from-font;
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
  }

  /* Auth guard: hide content until authenticated */
  body[data-require-auth="true"]:not(.auth-ready) > :not(script) {
    display: none !important;
  }

  body[data-require-auth="true"]:not(.auth-ready)::before {
    content: "";
    display: block;
    width: 40px;
    height: 40px;
    margin: 45vh auto;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
